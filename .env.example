# STUN servers (comma-separated)
STUN_URLS=stun:stun.l.google.com:19302

# TURN servers (comma-separated) — required for NAT traversal
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Set to "true" to force all connections through TURN relay (for testing)
FORCE_RELAY=false

# Rate limits (per IP per minute)
ROOM_CREATE_LIMIT=10
ROOM_JOIN_LIMIT=20
